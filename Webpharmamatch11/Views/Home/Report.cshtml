@model IEnumerable<pharmamatch.Application.DTOs.ProductMedicineDto>
@{
    Layout = null; // عرض مستقل بدون عناصر القائمة الجانبية أو الهيدر العام للتركيز على الطباعة
    string reportTitle = ViewBag.ReportTitle as string ?? "تقرير المخزون الشامل للأدوية";
    string reportDate = ViewBag.ReportDate as string ?? DateTime.Now.ToString("yyyy/MM/dd HH:mm");
    string doctorName = ViewBag.DoctorName as string ?? "د. ياسر المنصوري";
    string pharmacyName = ViewBag.PharmacyName as string ?? "صيدلية فارماماتش المركزية";
    string licenseNumber = ViewBag.LicenseNumber as string ?? "PH-884920";
    string reportType = ViewBag.ReportType as string ?? "all";
    int totalItems = ViewBag.TotalItems != null ? (int)ViewBag.TotalItems : (Model?.Count() ?? 0);
    int totalUnits = ViewBag.TotalUnits != null ? (int)ViewBag.TotalUnits : (Model?.Sum(m => m.TotalQuantity) ?? 0);

    string GetExpiryClass(DateTime? date)
    {
        if (!date.HasValue) return "badge bg-light text-dark border";
        var dt = date.Value;
        if (dt < DateTime.Now) return "badge bg-danger text-white";
        int monthsLeft = (dt.Year - DateTime.Now.Year) * 12 + dt.Month - DateTime.Now.Month;
        if (monthsLeft < 3) return "badge bg-danger text-white";
        if (monthsLeft <= 6) return "badge bg-warning text-dark";
        return "badge bg-success text-white";
    }
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@reportTitle - PharmaMatch</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Cairo', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
            font-size: 14px;
        }

        .report-page {
            max-width: 1100px;
            margin: 25px auto;
            background: #ffffff;
            padding: 35px 40px;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
            border: 1px solid #e2e8f0;
        }

        .report-header {
            border-bottom: 2px solid #0d6efd;
            padding-bottom: 20px;
            margin-bottom: 25px;
        }

        .kpi-box {
            background-color: #f1f5f9;
            border-radius: 12px;
            padding: 12px 18px;
            border: 1px solid #e2e8f0;
        }

        .table > :not(caption) > * > * {
            padding: 0.75rem 0.6rem;
        }

        .table-custom thead th {
            background-color: #0d6efd;
            color: #ffffff;
            font-weight: 700;
            border: none;
            font-size: 13.5px;
        }

        .table-custom tbody tr:nth-of-type(even) {
            background-color: #f8fafc;
        }

        .table-custom tbody tr:hover {
            background-color: #f1f5f9;
        }

        .signature-section {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px dashed #cbd5e1;
        }

        /* 🖨️ استايلات وتنسيقات الطباعة الدقيقة */
        @@media print {
            body {
                background-color: #ffffff !important;
                font-size: 12px !important;
            }

            .no-print {
                display: none !important;
            }

            .report-page {
                max-width: 100% !important;
                margin: 0 !important;
                padding: 10px !important;
                border: none !important;
                box-shadow: none !important;
            }

            .table-custom thead th {
                background-color: #0d6efd !important;
                color: #ffffff !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .badge {
                border: 1px solid #cbd5e1 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>

    <!-- شريط أدوات التحكم العلوي (يختفي عند الطباعة) -->
    <div class="container-fluid no-print py-3 bg-white border-bottom shadow-sm mb-3">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <a href="/Home/Index" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-bold">
                    <i class="bi bi-arrow-right"></i> لوحة التحكم
                </a>
                <a href="/Home/Search" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-bold">
                    <i class="bi bi-search"></i> واجهة البحث
                </a>
            </div>

            <!-- أزرار تبديل نوع التقرير السريع -->
            <div class="btn-group rounded-pill p-1 bg-light border">
                <a href="/Home/Report?type=all" class="btn btn-sm rounded-pill px-3 @(reportType == "all" ? "btn-primary fw-bold" : "btn-light text-muted")">
                    الكل (@totalUnits وحدة)
                </a>
                <a href="/Home/Report?type=critical" class="btn btn-sm rounded-pill px-3 @(reportType == "critical" || reportType == "shortage" ? "btn-danger fw-bold text-white" : "btn-light text-muted")">
                    النواقص والحرجة
                </a>
                <a href="/Home/Report?type=expired" class="btn btn-sm rounded-pill px-3 @(reportType == "expired" ? "btn-warning fw-bold text-dark" : "btn-light text-muted")">
                    منتهية الصلاحية
                </a>
                <a href="/Home/Report?type=watchlist" class="btn btn-sm rounded-pill px-3 @(reportType == "watchlist" ? "btn-info fw-bold text-white" : "btn-light text-muted")">
                    قائمة المتابعة
                </a>
            </div>

            <div class="d-flex gap-2">
                <button onclick="window.print()" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm d-flex align-items-center gap-2">
                    <i class="bi bi-printer-fill fs-5"></i> 🖨️ طباعة التقرير مباشرة
                </button>
            </div>
        </div>
    </div>

    <!-- ورقة التقرير المنسقة للطباعة -->
    <div class="report-page">
        <!-- 1. ترويسة التقرير الرسمية -->
        <div class="report-header">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary text-white p-3 rounded-4 fs-2 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <i class="bi bi-hospital"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold text-primary mb-1">PharmaMatch | شبكة الصيدليات</h3>
                        <h5 class="fw-bold text-dark mb-0">@pharmacyName</h5>
                    </div>
                </div>

                <div class="text-start">
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2 rounded-pill fs-6 fw-bold d-inline-block mb-2">
                        @reportTitle
                    </span>
                    <div class="text-muted small">
                        <div><b>تاريخ التقرير:</b> @reportDate</div>
                        <div><b>رقم الترخيص:</b> @licenseNumber</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. كروت إحصائيات التقرير -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="kpi-box text-center">
                    <div class="small text-muted fw-bold">إجمالي الأصناف بالتقرير</div>
                    <div class="fs-4 fw-bold text-primary my-1">@totalItems.ToString("N0") صنف</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="kpi-box text-center">
                    <div class="small text-muted fw-bold">إجمالي كميات الوحدات بالمخزن</div>
                    <div class="fs-4 fw-bold text-success my-1">@totalUnits.ToString("N0") وحدة</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="kpi-box text-center">
                    <div class="small text-muted fw-bold">الصيدلاني المسؤول</div>
                    <div class="fs-5 fw-bold text-dark my-1">@doctorName</div>
                </div>
            </div>
        </div>

        <!-- 3. جدول الأدوية المنسق -->
        <div class="table-responsive">
            <table class="table table-custom table-bordered align-middle mb-0 text-center">
                <thead>
                    <tr>
                        <th style="width: 45px;">#</th>
                        <th class="text-end">اسم الدواء التجاري</th>
                        <th class="text-end">المادة الفعالة والتركيز</th>
                        <th>الفئة الطبية</th>
                        <th>رقم التشغيلة</th>
                        <th>تاريخ الانتهاء</th>
                        <th>المخزون المتاح</th>
                        <th>السعر (ريال)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int index = 1;
                        foreach (var item in Model)
                        {
                            int stock = item.TotalQuantity;
                            var latestBatch = item.InventoryBatches?.OrderBy(b => b.ExpiryDate).FirstOrDefault();
                            string expiryText = latestBatch != null ? latestBatch.ExpiryDate.ToString("dd/MM/yyyy") : "غير محدد";
                            string batchNum = latestBatch?.BatchNumber ?? $"BN-{item.Id}";
                            string categoryName = item.CategoryName ?? "عام";
                            string expiryClass = GetExpiryClass(latestBatch?.ExpiryDate);

                            <tr>
                                <td class="fw-bold text-muted">@index</td>
                                <td class="text-end fw-bold text-dark">
                                    💊 @item.TradeName
                                </td>
                                <td class="text-end text-muted fw-semibold">
                                    @(item.ScientificName ?? "غير محدد")
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">@categoryName</span>
                                </td>
                                <td class="small font-monospace text-muted">
                                    @batchNum
                                </td>
                                <td>
                                    <span class="@expiryClass px-2 py-1 rounded-pill small">@expiryText</span>
                                </td>
                                <td class="fw-bold @(stock <= 50 ? "text-danger" : "text-dark")">
                                    @stock.ToString("N0")
                                    @if (stock <= 50)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger small ms-1">حرج</span>
                                    }
                                </td>
                                <td class="fw-bold text-success">
                                    @item.Price.ToString("N2")
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                لا توجد أدوية مطابقة لمعايير هذا التقرير حالياً.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- 4. تذييل التقرير والتوقيع الرسمي -->
        <div class="signature-section d-flex justify-content-between align-items-end text-muted small">
            <div>
                <div>• تم استخراج هذا التقرير تلقائياً عبر نظام إدارة الصيدلية الذكي <b>PharmaMatch Web</b>.</div>
                <div>• البيانات مطابقة تماماً لسجلات المخزون وقاعدة البيانات المركزية.</div>
            </div>
            <div class="text-center" style="min-width: 220px;">
                <div class="mb-4"><b>اعتماد الصيدلاني المسؤول:</b></div>
                <div class="fw-bold text-dark">@doctorName</div>
                <div class="text-muted" style="letter-spacing: 2px;">______________________</div>
            </div>
        </div>
    </div>

</body>
</html>
